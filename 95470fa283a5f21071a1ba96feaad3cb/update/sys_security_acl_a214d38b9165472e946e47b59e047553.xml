    <sys_security_acl action="INSERT_OR_UPDATE">
        <active>true</active>
        <admin_overrides>true</admin_overrides>
        <advanced>true</advanced>
        <applies_to/>
        <condition/>
        <controlled_by_refs/>
        <decision_type>allow</decision_type>
        <description>Instructors can create materials for their courses</description>
        <local_or_existing>Local</local_or_existing>
        <name>x_1879300_learning_materials</name>
        <operation display_value="create">create</operation>
        <script><![CDATA[
        // Check if user can modify the associated lesson/course
        var lessonGR = new GlideRecord('x_1879300_learning_lessons');
        if (lessonGR.get(current.lesson)) {
            var courseGR = new GlideRecord('x_1879300_learning_courses');
            if (courseGR.get(lessonGR.course)) {
                if (gs.hasRole('x_1879300_learning.admin')) {
                    return true;
                }
                return courseGR.getValue('created_by') == gs.getUserID();
            }
        }
        return false;
    ]]></script>
