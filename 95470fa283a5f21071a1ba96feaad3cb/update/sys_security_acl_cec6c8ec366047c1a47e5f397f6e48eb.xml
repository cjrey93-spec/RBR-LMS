<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_security_acl">
    <sys_security_acl action="INSERT_OR_UPDATE">
        <active>true</active>
        <admin_overrides>true</admin_overrides>
        <advanced>true</advanced>
        <applies_to/>
        <condition table="x_1879300_learning_materials">material_type=attachment^uploaded_byISEMPTY<item display_value="File Attachment" endquery="false" field="material_type" goto="false" newquery="false" operator="=" or="false" value="attachment"/>
            <item endquery="false" field="uploaded_by" goto="false" newquery="false" operator="ISEMPTY" or="false" value=""/>
        </condition>
        <controlled_by_refs/>
        <decision_type>allow</decision_type>
        <description>Students can upload attachment materials for courses they are taking</description>
        <local_or_existing>Local</local_or_existing>
        <name>x_1879300_learning_materials</name>
        <operation display_value="create">create</operation>
        <script><![CDATA[
        // Students can only upload materials, not create other types
        if (current.getValue('material_type') != 'attachment') {
            return false;
        }
        
        // Check if they can access the lesson
        var lessonGR = new GlideRecord('x_1879300_learning_lessons');
        if (lessonGR.get(current.lesson)) {
            var courseGR = new GlideRecord('x_1879300_learning_courses');
            if (courseGR.get(lessonGR.course)) {
                return courseGR.getValue('published') == 'true' && courseGR.getValue('active') == 'true';
            }
        }
        return false;
    ]]></script>
        <security_attribute/>
        <sys_class_name>sys_security_acl</sys_class_name>
