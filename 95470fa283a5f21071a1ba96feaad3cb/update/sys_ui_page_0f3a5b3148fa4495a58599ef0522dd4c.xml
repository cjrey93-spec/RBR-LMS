function openQuestionBuilder(aid, atitle) {
  selectedAssessment = { id: aid, title: atitle };
  document.getElementById('questions-assess-banner').innerHTML = '<span>Questions for: <strong>' + atitle + '</strong></span>';
  document.getElementById('pill-questions').classList.remove('hidden');
