    .catch(function(){ showMsg('Failed to add staff.', 'error'); });
});

function loadStaff() {
  if (!selectedCourse) return;
  var el = document.getElementById('staff-list');
  el.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
  fetch(API + '/' + SCOPE + '_course_staff?sysparm_query=course=' + selectedCourse.id + '^active=true&sysparm_display_value=all&sysparm_limit=50', { headers: hdrs() })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      var items = data.result || [];
      if (!items.length) {
        el.innerHTML = '<div class="empty-state"><div class="icon">&#128100;</div><p>No staff assigned.</p></div>';
        return;
      }
      var html = '<table class="tbl"><thead><tr><th>User</th><th>Role</th><th>Added</th><th></th></tr></thead><tbody>';
      items.forEach(function(s) {
        html += '<tr><td>' + getVal(s,'user') + '</td><td>' + getVal(s,'staff_role') + '</td>' +
          '<td>' + (getVal(s,'added_date') || '').split(' ')[0] + '</td>' +
          '<td><button class="btn btn-danger btn-sm" onclick="removeStaff(\'' + getVal(s,'sys_id') + '\')">Remove</button></td></tr>';
