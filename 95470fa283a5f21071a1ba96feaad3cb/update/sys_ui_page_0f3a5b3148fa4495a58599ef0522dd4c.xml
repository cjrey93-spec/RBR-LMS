  el.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
  fetch(API + '/' + SCOPE + '_lessons?sysparm_query=course=' + selectedCourse.id + '^ORDERBYorder_sequence&sysparm_display_value=all&sysparm_limit=100', { headers: hdrs() })
