  loadQuestions();
}

// Questions
document.getElementById('q-type').addEventListener('change', function() {
  var t = this.value;
  document.getElementById('q-choices-block').classList.toggle('hidden', t !== 'multiple_choice');
  document.getElementById('q-tf-block').classList.toggle('hidden', t !== 'true_false');
  document.getElementById('q-text-block').classList.toggle('hidden', t === 'multiple_choice' || t === 'true_false');
});

function addChoice() {
  var list = document.getElementById('q-choices-list');
  var idx = list.children.length;
  var labels = ['A','B','C','D','E','F','G','H'];
  var row = document.createElement('div');
  row.className = 'choice-row';
  row.innerHTML = '<input type="radio" name="correct_choice" value="' + idx + '" /><input type="text" class="choice-text" placeholder="Choice ' + (labels[idx] || idx) + '" /><button type="button" class="btn btn-danger btn-sm" onclick="removeChoice(this)">X</button>';
  list.appendChild(row);
}

function removeChoice(btn) { btn.closest('.choice-row').remove(); }

document.getElementById('form-question').addEventListener('submit', function(e) {
  e.preventDefault();
  if (!selectedAssessment) return;
  var fd = new FormData(e.target);
  var qtype = fd.get('question_type');
  var body = {
    assessment: selectedAssessment.id,
    question_type: qtype,
    question_text: fd.get('question_text'),
    points: parseInt(fd.get('points')) || 1,
    order_sequence: parseInt(fd.get('order_sequence')) || 1,
    hint: fd.get('hint') || ''
  };
  if (qtype === 'true_false') body.correct_answer_text = fd.get('tf_answer');
  if (qtype === 'short_answer' || qtype === 'essay') body.correct_answer_text = fd.get('correct_answer_text') || '';

  fetch(API + '/' + SCOPE + '_questions', { method: 'POST', headers: hdrs(), body: JSON.stringify(body) })
    .then(function(r){ if (!r.ok) throw new Error(); return r.json(); })
    .then(function(data) {
      var qid = getVal(data.result, 'sys_id');
      if (qtype === 'multiple_choice') {
        var correctIdx = parseInt(fd.get('correct_choice') || '0');
        var choiceEls = document.querySelectorAll('.choice-text');
        var labels = ['A','B','C','D','E','F'];
        var promises = [];
        choiceEls.forEach(function(inp, i) {
          if (!inp.value.trim()) return;
          promises.push(fetch(API + '/' + SCOPE + '_question_choices', { method: 'POST', headers: hdrs(), body: JSON.stringify({
            question: qid, choice_text: inp.value, choice_label: labels[i] || String(i+1), is_correct: i === correctIdx, order_sequence: i+1
          })}));
        });
        return Promise.all(promises);
      }
    })
    .then(function(){
      showMsg('Question added!', 'success');
      e.target.reset();
      loadQuestions();
    })
    .catch(function(){ showMsg('Failed to add question.', 'error'); });
});

function loadQuestions() {
  if (!selectedAssessment) return;
  var el = document.getElementById('questions-list');
  el.innerHTML = '<div class="loading"><div class="spinner"></div></div>';
  fetch(API + '/' + SCOPE + '_questions?sysparm_query=assessment=' + selectedAssessment.id + '^ORDERBYorder_sequence&sysparm_display_value=all&sysparm_limit=50', { headers: hdrs() })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      var qs = data.result || [];
      if (!qs.length) {
        el.innerHTML = '<div class="empty-state"><div class="icon">&#10067;</div><p>No questions yet.</p></div>';
        return;
      }
      var html = '';
      qs.forEach(function(q, i) {
        var qt = getVal(q,'question_type');
        html += '<div class="question-block"><strong>' + (i+1) + '. [' + qt + ']</strong> ' + getVal(q,'question_text') +
          ' <span style="color:#a0aec0;font-size:.8rem">(' + getVal(q,'points') + ' pt)</span>' +
          '<div style="margin-top:8px"><button class="btn btn-danger btn-sm" onclick="deleteQuestion(\'' + getVal(q,'sys_id') + '\')">Delete</button></div></div>';
      });
      el.innerHTML = html;
    })
    .catch(function(){ el.innerHTML = '<div class="alert alert-error">Failed to load.</div>'; });
}

function deleteQuestion(id) {
  if (!confirm('Delete this question?')) return;
  fetch(API + '/' + SCOPE + '_questions/' + id, { method: 'DELETE', headers: hdrs() })
    .then(function(){ loadQuestions(); });
}

// Staff
document.getElementById('form-staff').addEventListener('submit', function(e) {
  e.preventDefault();
  if (!selectedCourse) return;
  var fd = new FormData(e.target);
  var body = { course: selectedCourse.id, user: fd.get('user'), staff_role: fd.get('staff_role'), active: true, added_by: currentUser };
  fetch(API + '/' + SCOPE + '_course_staff', { method: 'POST', headers: hdrs(), body: JSON.stringify(body) })
