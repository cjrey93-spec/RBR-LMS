<?xml version="1.0" encoding="UTF-8"?><record_update table="sys_ui_page">
    <sys_ui_page action="INSERT_OR_UPDATE">
        <category>general</category>
        <client_script/>
        <description>Instructor interface for creating and managing courses, lessons, assessments, staff, and grading</description>
        <direct>true</direct>
        <endpoint>x_1879300_learning_instructor_dashboard.do</endpoint>
        <html><![CDATA[<html>
<head>
  <title>Instructor Dashboard - LMS</title>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <script>window.NOW={};window.NOW.user={};window.NOW.batch_glide_ajax_requests=false;window.NOW.isUsingPolaris=true;window.g_ck="$[gs.getSession().getSessionToken() || gs.getSessionToken()]";</script>
  <g:requires name="scripts/doctype/functions_bootstrap14.js" />
  <g:requires name="scripts/lib/prototype.js" />
  <g:requires name="scripts/classes/ajax/GlideURL.js" />
  <g:requires name="scripts/doctype/CustomEventManager.js" />
  <g:requires name="scripts/classes/ajax/GlideAjax.js" />
  <g:requires name="scripts/classes/GlideUser.js" />
  <g2:client_script type="user" />
  <style>
    *{margin:0;padding:0;box-sizing:border-box}
    body{font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;background:linear-gradient(135deg,#667eea 0%,#764ba2 100%);min-height:100vh}
    .wrap{max-width:1280px;margin:0 auto;padding:20px}
    .hdr{text-align:center;color:#fff;margin-bottom:24px}
    .hdr h1{font-size:2.2rem;margin-bottom:6px}
    .hdr p{opacity:.85}
    .tabs{display:flex;flex-wrap:wrap;gap:6px;background:rgba(255,255,255,.12);border-radius:12px;padding:8px;margin-bottom:24px;backdrop-filter:blur(10px)}
    .tab-btn{padding:10px 18px;border:none;background:transparent;color:#fff;border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:500;transition:all .25s}
    .tab-btn:hover{background:rgba(255,255,255,.15)}
    .tab-btn.active{background:#fff;color:#667eea;font-weight:700}
    .card{background:#fff;border-radius:16px;padding:28px;box-shadow:0 10px 40px rgba(0,0,0,.1);min-height:480px}
    .section-title{font-size:1.5rem;color:#2d3748;margin-bottom:20px}
    .form-group{margin-bottom:16px}
    .form-group label{display:block;margin-bottom:4px;font-weight:600;color:#4a5568;font-size:.9rem}
    .form-group input,.form-group textarea,.form-group select{width:100%;padding:10px 12px;border:2px solid #e2e8f0;border-radius:8px;font-size:.95rem;transition:border-color .2s;font-family:inherit}
    .form-group input:focus,.form-group textarea:focus,.form-group select:focus{outline:none;border-color:#667eea}
    .form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
    .form-row-3{display:grid;grid-template-columns:1fr 1fr 1fr;gap:16px}
    .btn{padding:10px 20px;border:none;border-radius:8px;cursor:pointer;font-size:.9rem;font-weight:600;transition:all .2s;display:inline-flex;align-items:center;gap:6px}
    .btn-primary{background:linear-gradient(135deg,#667eea,#764ba2);color:#fff}
    .btn-primary:hover{transform:translateY(-1px);box-shadow:0 4px 12px rgba(102,126,234,.4)}
    .btn-secondary{background:#f7fafc;color:#4a5568;border:2px solid #e2e8f0}
    .btn-secondary:hover{background:#edf2f7}
    .btn-danger{background:#fff5f5;color:#c53030;border:2px solid #fed7d7}
    .btn-danger:hover{background:#fed7d7}
    .btn-sm{padding:6px 12px;font-size:.8rem}
    .grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:16px;margin-top:16px}
    .course-card{background:#f7fafc;border:2px solid #e2e8f0;border-radius:12px;padding:18px;transition:all .2s}
    .course-card:hover{transform:translateY(-2px);box-shadow:0 6px 20px rgba(0,0,0,.1);border-color:#667eea}
    .course-card.selected{border-color:#667eea;background:#ebf4ff}
    .course-title{font-size:1.05rem;font-weight:700;color:#2d3748;margin-bottom:6px}
    .course-desc{font-size:.85rem;color:#718096;margin-bottom:10px;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
    .meta-row{display:flex;gap:8px;flex-wrap:wrap;margin-bottom:10px}
    .badge{padding:3px 10px;border-radius:20px;font-size:.75rem;font-weight:700}
    .badge-beginner{background:#bee3f8;color:#2b6cb0}
    .badge-intermediate{background:#fbb6ce;color:#b83280}
    .badge-advanced{background:#fbd38d;color:#c05621}
    .badge-published{background:#c6f6d5;color:#22543d}
    .badge-draft{background:#fed7d7;color:#c53030}
    .badge-video{background:#e9d8fd;color:#553c9a}
    .badge-text{background:#bee3f8;color:#2b6cb0}
    .badge-quiz{background:#fbb6ce;color:#97266d}
    .badge-assignment{background:#fbd38d;color:#c05621}
    .card-actions{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
    .tbl{width:100%;border-collapse:collapse;margin-top:12px}
    .tbl th{background:#f7fafc;padding:10px 12px;text-align:left;font-size:.85rem;color:#4a5568;border-bottom:2px solid #e2e8f0}
    .tbl td{padding:10px 12px;border-bottom:1px solid #e2e8f0;font-size:.9rem;color:#2d3748;vertical-align:middle}
    .tbl tr:hover td{background:#f7fafc}
    .alert{padding:12px 16px;border-radius:8px;margin-bottom:16px;font-size:.9rem}
    .alert-success{background:#c6f6d5;color:#22543d}
    .alert-error{background:#fed7d7;color:#c53030}
    .hidden{display:none!important}
    .loading{text-align:center;padding:40px;color:#718096}
    .spinner{border:3px solid #e2e8f0;border-top:3px solid #667eea;border-radius:50%;width:32px;height:32px;animation:spin .8s linear infinite;margin:0 auto 12px}
    @keyframes spin{to{transform:rotate(360deg)}}
    .empty-state{text-align:center;padding:48px;color:#a0aec0}
    .empty-state .icon{font-size:3rem;margin-bottom:12px}
    .question-block{border:2px solid #e2e8f0;border-radius:10px;padding:16px;margin-bottom:16px}
    .choice-row{display:flex;align-items:center;gap:10px;margin-bottom:8px}
    .choice-row input[type=text]{flex:1}
    .sub-card{background:#f7fafc;border-radius:8px;padding:14px;margin-bottom:12px;border-left:4px solid #667eea}
    .selected-banner{background:#ebf4ff;border:2px solid #667eea;border-radius:8px;padding:12px;margin-bottom:20px;display:flex;align-items:center;justify-content:space-between}
    .pill-row{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}
    .pill{padding:6px 16px;border-radius:20px;border:2px solid #e2e8f0;background:#fff;cursor:pointer;font-size:.85rem;font-weight:500;color:#4a5568}
    .pill.active{border-color:#667eea;background:#ebf4ff;color:#553c9a}
    .two-col{display:grid;grid-template-columns:1fr 1fr;gap:24px}
  </style>
</head>
<body>
<div class="wrap">
  <div class="hdr">
    <h1>Instructor Dashboard</h1>
    <p>Create and manage courses, lessons, assessments, and students</p>
  </div>
  <nav class="tabs">
    <button class="tab-btn active" data-tab="create">+ Create Course</button>
    <button class="tab-btn" data-tab="courses">My Courses</button>
    <button class="tab-btn" data-tab="lessons">Lessons</button>
    <button class="tab-btn" data-tab="assessments">Assessments</button>
    <button class="tab-btn" data-tab="staff">Staff</button>
    <button class="tab-btn" data-tab="grading">Grade Submissions</button>
  </nav>
  <div class="card">
    <div id="msg-global"></div>

    <!-- TAB: Create Course -->
    <div id="tab-create" class="tab-pane">
      <h2 class="section-title">Create New Course</h2>
      <form id="form-course">
        <div class="form-row">
          <div class="form-group">
            <label>Course Title *</label>
            <input type="text" name="title" required placeholder="e.g. Introduction to Python" />
          </div>
          <div class="form-group">
            <label>Category *</label>
            <select name="category" required>
              <option value="">Select...</option>
              <option value="programming">Programming</option>
              <option value="web_development">Web Development</option>
              <option value="data_science">Data Science</option>
              <option value="devops">DevOps and Infrastructure</option>
              <option value="mobile">Mobile Development</option>
              <option value="cybersecurity">Cybersecurity</option>
              <option value="cloud">Cloud Computing</option>
              <option value="other">Other</option>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label>Description *</label>
          <textarea name="description" rows="3" required placeholder="What will students learn in this course?"></textarea>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label>Difficulty Level *</label>
            <select name="difficulty_level" required>
              <option value="">Select...</option>
              <option value="beginner">Beginner</option>
              <option value="intermediate">Intermediate</option>
              <option value="advanced">Advanced</option>
            </select>
          </div>
          <div class="form-group">
            <label>Estimated Duration (hours)</label>
            <input type="number" name="estimated_duration_hours" min="1" max="500" placeholder="e.g. 10" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
              <input type="checkbox" name="published" style="width:auto" /> Publish immediately
            </label>
          </div>
          <div class="form-group">
            <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
              <input type="checkbox" name="active" checked style="width:auto" /> Active
            </label>
          </div>
        </div>
        <button type="submit" class="btn btn-primary">Create Course</button>
      </form>
    </div>

    <!-- TAB: My Courses -->
    <div id="tab-courses" class="tab-pane hidden">
      <h2 class="section-title">My Courses</h2>
      <div id="courses-list"><div class="loading"><div class="spinner"></div>Loading...</div></div>
    </div>

    <!-- TAB: Lessons -->
    <div id="tab-lessons" class="tab-pane hidden">
      <h2 class="section-title">Manage Lessons</h2>
      <div id="lessons-course-banner">
        <div class="empty-state"><div class="icon">&#128218;</div><p>Select a course from "My Courses" to manage its lessons.</p></div>
      </div>
      <div id="lessons-main" class="hidden">
        <div id="lessons-selected-banner" class="selected-banner"></div>
        <div class="two-col">
          <div>
            <h3 style="color:#2d3748;margin-bottom:12px">Add Lesson</h3>
            <form id="form-lesson">
              <div class="form-group">
                <label>Title *</label>
                <input type="text" name="title" required placeholder="Lesson title" />
              </div>
              <div class="form-row">
                <div class="form-group">
                  <label>Type *</label>
                  <select name="lesson_type" id="lesson-type-select" required>
                    <option value="text">Text / Reading</option>
                    <option value="video">Video</option>
                    <option value="quiz">Quiz</option>
                    <option value="assignment">Assignment</option>
                  </select>
                </div>
                <div class="form-group">
                  <label>Order</label>
                  <input type="number" name="order_sequence" min="1" value="1" />
                </div>
              </div>
              <div class="form-group">
                <label>Short Description</label>
                <input type="text" name="description" placeholder="Brief description" />
              </div>
              <div class="form-group" id="lesson-content-group">
                <label>Content</label>
                <textarea name="content" rows="5" placeholder="Write lesson content here..."></textarea>
              </div>
              <div class="form-group hidden" id="lesson-video-group">
                <label>Video URL</label>
                <input type="url" name="video_url" placeholder="https://www.youtube.com/watch?v=..." />
              </div>
              <button type="submit" class="btn btn-primary">Add Lesson</button>
            </form>
          </div>
          <div>
            <h3 style="color:#2d3748;margin-bottom:12px">Existing Lessons</h3>
            <div id="lessons-list"><div class="loading"><div class="spinner"></div></div></div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Assessments -->
    <div id="tab-assessments" class="tab-pane hidden">
      <h2 class="section-title">Assessments</h2>
      <div id="assess-course-banner">
        <div class="empty-state"><div class="icon">&#128203;</div><p>Select a course from "My Courses" to manage assessments.</p></div>
      </div>
      <div id="assess-main" class="hidden">
        <div id="assess-selected-banner" class="selected-banner"></div>
        <div class="pill-row">
          <button class="pill active" id="pill-list" onclick="showAssessPanel('list')">Assessments</button>
          <button class="pill" id="pill-create" onclick="showAssessPanel('create')">+ New Assessment</button>
          <button class="pill hidden" id="pill-questions" onclick="showAssessPanel('questions')">Questions</button>
        </div>
        <div id="assess-panel-list">
          <div id="assessments-list"><div class="loading"><div class="spinner"></div></div></div>
        </div>
        <div id="assess-panel-create" class="hidden">
          <form id="form-assessment">
            <div class="form-row">
              <div class="form-group">
                <label>Title *</label>
                <input type="text" name="title" required placeholder="e.g. Module 1 Quiz" />
              </div>
              <div class="form-group">
                <label>Type</label>
                <select name="assessment_type">
                  <option value="quiz">Quiz</option>
                  <option value="exam">Exam</option>
                  <option value="practice">Practice</option>
                  <option value="assignment">Assignment</option>
                </select>
              </div>
            </div>
            <div class="form-row-3">
              <div class="form-group">
                <label>Passing Score (%)</label>
                <input type="number" name="passing_score" min="0" max="100" value="70" />
              </div>
              <div class="form-group">
                <label>Time Limit (min, 0=none)</label>
                <input type="number" name="time_limit_minutes" min="0" value="0" />
              </div>
              <div class="form-group">
                <label>Max Attempts (0=unlimited)</label>
                <input type="number" name="max_attempts" min="0" value="3" />
              </div>
            </div>
            <div class="form-group">
              <label style="display:flex;align-items:center;gap:8px;cursor:pointer">
                <input type="checkbox" name="show_results_immediately" checked style="width:auto" />
                Show results immediately after submission
              </label>
            </div>
            <button type="submit" class="btn btn-primary">Create Assessment</button>
          </form>
        </div>
        <div id="assess-panel-questions" class="hidden">
          <div id="questions-assess-banner" class="selected-banner" style="margin-bottom:16px"></div>
          <div class="two-col">
            <div>
              <h3 style="margin-bottom:12px;color:#2d3748">Add Question</h3>
              <form id="form-question">
                <div class="form-row">
                  <div class="form-group">
                    <label>Type *</label>
                    <select name="question_type" id="q-type" required>
                      <option value="multiple_choice">Multiple Choice</option>
                      <option value="true_false">True / False</option>
                      <option value="short_answer">Short Answer</option>
                      <option value="essay">Essay</option>
                    </select>
                  </div>
                  <div class="form-group">
                    <label>Points</label>
                    <input type="number" name="points" min="1" value="1" />
                  </div>
                </div>
                <div class="form-group">
                  <label>Question Text *</label>
                  <textarea name="question_text" rows="2" required placeholder="Enter the question..."></textarea>
                </div>
                <div id="q-choices-block">
                  <label style="font-weight:600;color:#4a5568;font-size:.9rem;margin-bottom:6px;display:block">Answer Choices (select correct)</label>
                  <div id="q-choices-list">
                    <div class="choice-row"><input type="radio" name="correct_choice" value="0" /><input type="text" class="choice-text" placeholder="Choice A" /><button type="button" class="btn btn-danger btn-sm" onclick="removeChoice(this)">X</button></div>
                    <div class="choice-row"><input type="radio" name="correct_choice" value="1" /><input type="text" class="choice-text" placeholder="Choice B" /><button type="button" class="btn btn-danger btn-sm" onclick="removeChoice(this)">X</button></div>
                  </div>
                  <button type="button" class="btn btn-secondary btn-sm" style="margin-top:8px" onclick="addChoice()">+ Add Choice</button>
                </div>
                <div id="q-tf-block" class="hidden form-group">
                  <label>Correct Answer</label>
                  <select name="tf_answer">
                    <option value="true">True</option>
                    <option value="false">False</option>
                  </select>
                </div>
                <div id="q-text-block" class="hidden form-group">
                  <label>Model Answer (for reference)</label>
                  <input type="text" name="correct_answer_text" placeholder="Expected keywords or answer" />
                </div>
                <div class="form-group" style="margin-top:10px">
                  <label>Hint (optional)</label>
                  <input type="text" name="hint" placeholder="Hint shown to students" />
                </div>
                <div class="form-group">
                  <label>Order</label>
                  <input type="number" name="order_sequence" min="1" value="1" />
                </div>
                <button type="submit" class="btn btn-primary">Add Question</button>
              </form>
            </div>
            <div>
              <h3 style="margin-bottom:12px;color:#2d3748">Questions</h3>
              <div id="questions-list"><div class="loading"><div class="spinner"></div></div></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- TAB: Staff -->
    <div id="tab-staff" class="tab-pane hidden">
      <h2 class="section-title">Course Staff</h2>
      <div id="staff-course-banner">
        <div class="empty-state"><div class="icon">&#128101;</div><p>Select a course from "My Courses" to manage its staff.</p></div>
      </div>
      <div id="staff-main" class="hidden">
        <div id="staff-selected-banner" class="selected-banner"></div>
        <div class="form-row" style="margin-bottom:24px;align-items:end">
          <form id="form-staff" style="display:contents">
            <div class="form-group">
              <label>User sys_id</label>
              <input type="text" name="user" required placeholder="User sys_id" />
            </div>
            <div class="form-group">
              <label>Role</label>
              <select name="staff_role">
                <option value="ta">Teaching Assistant</option>
                <option value="co_instructor">Co-Instructor</option>
                <option value="instructor">Instructor</option>
              </select>
            </div>
          </form>
          <div style="padding-bottom:16px">
            <button class="btn btn-primary" onclick="document.getElementById('form-staff').dispatchEvent(new Event('submit',{cancelable:true}))">Add Staff</button>
          </div>
        </div>
        <div id="staff-list"><div class="loading"><div class="spinner"></div>Loading...</div></div>
      </div>
    </div>

    <!-- TAB: Grade Submissions -->
    <div id="tab-grading" class="tab-pane hidden">
      <h2 class="section-title">Grade Student Submissions</h2>
      <div class="form-row" style="margin-bottom:16px">
        <div class="form-group">
          <label>Filter by Course</label>
          <select id="grading-course-filter"><option value="">All my courses</option></select>
        </div>
        <div class="form-group">
          <label>Status</label>
          <select id="grading-status-filter">
            <option value="submitted">Submitted (pending grading)</option>
            <option value="graded">Already graded</option>
            <option value="">All</option>
          </select>
        </div>
      </div>
      <button class="btn btn-secondary" style="margin-bottom:20px" onclick="loadSubmissions()">Refresh</button>
      <div id="submissions-list"><div class="loading"><div class="spinner"></div>Loading...</div></div>
    </div>
  </div>
</div>

<script>
var API = '/api/now/table';
var SCOPE = 'x_1879300_learning';
var currentUser = '';
var currentUserName = '';
var selectedCourse = null;
var selectedAssessment = null;
var myCourses = [];

function hdrs() {
  return { 'Accept': 'application/json', 'Content-Type': 'application/json', 'X-UserToken': window.g_ck };
}

function showMsg(msg, type) {
  var el = document.getElementById('msg-global');
  el.innerHTML = '<div class="alert alert-' + type + '">' + msg + '</div>';
  if (type !== 'error') setTimeout(function(){ el.innerHTML = ''; }, 5000);
}

function getVal(obj, field) {
  if (!obj) return '';
  var v = obj[field];
  if (v && typeof v === 'object') return v.display_value || v.value || '';
  return v || '';
}

function escQ(s) { return (s || '').replace(/'/g, "\\'"); }

// Tab switching
document.querySelectorAll('.tab-btn').forEach(function(btn) {
  btn.addEventListener('click', function() {
    document.querySelectorAll('.tab-btn').forEach(function(b){ b.classList.remove('active'); });
    document.querySelectorAll('.tab-pane').forEach(function(p){ p.classList.add('hidden'); });
    btn.classList.add('active');
    var tab = btn.dataset.tab;
    document.getElementById('tab-' + tab).classList.remove('hidden');
    if (tab === 'courses') loadMyCourses();
    if (tab === 'grading') loadSubmissions();
  });
});

// Create Course
document.getElementById('form-course').addEventListener('submit', function(e) {
  e.preventDefault();
  var fd = new FormData(e.target);
  var body = {
    title: fd.get('title'),
    description: fd.get('description'),
    category: fd.get('category'),
    difficulty_level: fd.get('difficulty_level'),
    estimated_duration_hours: fd.get('estimated_duration_hours') || 0,
    published: fd.has('published'),
    active: fd.has('active'),
    instructor: currentUser
  };
  fetch(API + '/' + SCOPE + '_courses', { method: 'POST', headers: hdrs(), body: JSON.stringify(body) })
    .then(function(r){ if (!r.ok) throw new Error(); showMsg('Course created!', 'success'); e.target.reset(); myCourses = []; })
    .catch(function(){ showMsg('Failed to create course.', 'error'); });
});

// My Courses
function loadMyCourses() {
  var el = document.getElementById('courses-list');
  el.innerHTML = '<div class="loading"><div class="spinner"></div>Loading...</div>';
  var q = 'instructor=' + currentUser + '^ORcreated_by=' + currentUserName;
  fetch(API + '/' + SCOPE + '_courses?sysparm_query=' + encodeURIComponent(q) + '&sysparm_display_value=all&sysparm_limit=100', { headers: hdrs() })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      myCourses = data.result || [];
      populateGradingFilter(myCourses);
      if (!myCourses.length) {
        el.innerHTML = '<div class="empty-state"><div class="icon">&#128218;</div><p>No courses yet.</p></div>';
        return;
      }
      var grid = document.createElement('div');
      grid.className = 'grid';
      myCourses.forEach(function(c) {
        var pub = c.published === true || c.published === 'true';
        var diff = getVal(c, 'difficulty_level');
        var cid = getVal(c, 'sys_id');
        var ctitle = getVal(c, 'title');
        var sel = selectedCourse && selectedCourse.id === cid;
        var card = document.createElement('div');
        card.className = 'course-card' + (sel ? ' selected' : '');
        card.innerHTML =
          '<div class="course-title">' + ctitle + '</div>' +
          '<div class="course-desc">' + getVal(c,'description') + '</div>' +
          '<div class="meta-row">' +
            '<span class="badge badge-' + diff + '">' + diff + '</span>' +
            '<span class="badge badge-' + (pub ? 'published' : 'draft') + '">' + (pub ? 'Published' : 'Draft') + '</span>' +
          '</div>' +
          '<div class="card-actions">' +
            '<button class="btn btn-primary btn-sm" onclick="selectCourse(\'' + cid + '\',\'' + escQ(ctitle) + '\')">Select</button>' +
            '<button class="btn btn-secondary btn-sm" onclick="togglePub(\'' + cid + '\',' + !pub + ')">' + (pub ? 'Unpublish' : 'Publish') + '</button>' +
          '</div>';
        grid.appendChild(card);
      });
      el.innerHTML = '';
      el.appendChild(grid);
    })
    .catch(function(){ el.innerHTML = '<div class="alert alert-error">Failed to load courses.</div>'; });
}

function togglePub(id, newPub) {
  fetch(API + '/' + SCOPE + '_courses/' + id, { method: 'PATCH', headers: hdrs(), body: JSON.stringify({ published: newPub }) })
    .then(function(){ loadMyCourses(); });
}

function selectCourse(id, title) {
  selectedCourse = { id: id, title: title };
  var bannerHtml = '<span><strong>' + title + '</strong> selected</span><button class="btn btn-secondary btn-sm" onclick="clearCourse()">Change</button>';
  ['lessons','assess','staff'].forEach(function(p) {
    var b = document.getElementById(p + '-course-banner');
    var m = document.getElementById(p + '-main');
    if (b && m) { b.classList.add('hidden'); m.classList.remove('hidden'); }
    var sb = document.getElementById(p + '-selected-banner');
    if (sb) sb.innerHTML = bannerHtml;
  });
  loadLessons();
  loadAssessments();
  loadStaff();
  showMsg('Course "' + title + '" selected', 'success');
  loadMyCourses();
}

function clearCourse() {
  selectedCourse = null;
  ['lessons','assess','staff'].forEach(function(p) {
    var b = document.getElementById(p + '-course-banner');
    var m = document.getElementById(p + '-main');
    if (b && m) { b.classList.remove('hidden'); m.classList.add('hidden'); }
  });
}

// Lessons
document.getElementById('lesson-type-select').addEventListener('change', function() {
  var t = this.value;
  document.getElementById('lesson-content-group').classList.toggle('hidden', t === 'video');
  document.getElementById('lesson-video-group').classList.toggle('hidden', t !== 'video');
});

document.getElementById('form-lesson').addEventListener('submit', function(e) {
