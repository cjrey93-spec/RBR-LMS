// Assessments
function showAssessPanel(panel) {
  ['list','create','questions'].forEach(function(p) {
    document.getElementById('assess-panel-' + p).classList.add('hidden');
    var pill = document.getElementById('pill-' + p);
    if (pill) pill.classList.remove('active');
  });
  document.getElementById('assess-panel-' + panel).classList.remove('hidden');
  var activePill = document.getElementById('pill-' + panel);
  if (activePill) activePill.classList.add('active');
}

document.getElementById('form-assessment').addEventListener('submit', function(e) {
  e.preventDefault();
  if (!selectedCourse) return;
  var fd = new FormData(e.target);
  var body = {
    title: fd.get('title'),
    course: selectedCourse.id,
    assessment_type: fd.get('assessment_type'),
    passing_score: parseInt(fd.get('passing_score')) || 70,
    time_limit_minutes: parseInt(fd.get('time_limit_minutes')) || 0,
    max_attempts: parseInt(fd.get('max_attempts')) || 3,
    show_results_immediately: fd.has('show_results_immediately')
  };
  fetch(API + '/' + SCOPE + '_assessments', { method: 'POST', headers: hdrs(), body: JSON.stringify(body) })
