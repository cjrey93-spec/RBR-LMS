// Grading
function populateGradingFilter(courses) {
  var sel = document.getElementById('grading-course-filter');
  while (sel.options.length > 1) sel.remove(1);
  (courses || []).forEach(function(c) {
    var opt = new Option(getVal(c,'title'), getVal(c,'sys_id'));
    sel.add(opt);
  });
}

function loadSubmissions() {
  var el = document.getElementById('submissions-list');
  el.innerHTML = '<div class="loading"><div class="spinner"></div>Loading...</div>';
  var courseId = document.getElementById('grading-course-filter').value;
  var status = document.getElementById('grading-status-filter').value;
  var query = '';
  if (status) query += 'status=' + status + '^';
  if (courseId) query += 'lesson.course=' + courseId + '^';
  query += 'ORDERBYDESCsubmitted_at';
  fetch(API + '/' + SCOPE + '_student_submission?sysparm_query=' + encodeURIComponent(query) + '&sysparm_display_value=all&sysparm_limit=50', { headers: hdrs() })
    .then(function(r){ return r.json(); })
    .then(function(data) {
      var subs = data.result || [];
      if (!subs.length) {
        el.innerHTML = '<div class="empty-state"><div class="icon">&#10003;</div><p>No submissions found.</p></div>';
        return;
      }
      var html = '';
      subs.forEach(function(s) {
        var sid = getVal(s,'sys_id');
        var st = getVal(s,'status');
        html += '<div class="sub-card">' +
          '<strong>' + getVal(s,'student') + '</strong> — Lesson: ' + getVal(s,'lesson') +
          ' <span class="badge" style="background:#e2e8f0;color:#4a5568">' + st + '</span><br/>' +
          '<em style="font-size:.85rem;color:#718096">Submitted: ' + (getVal(s,'submitted_at') || '').split(' ')[0] + '</em>';
        if (getVal(s,'student_notes')) html += '<p style="margin:8px 0;font-size:.9rem;color:#4a5568">' + getVal(s,'student_notes') + '</p>';
        if (st !== 'graded') {
          html += '<div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-top:10px">' +
            '<div class="form-group" style="margin:0"><label style="font-size:.8rem">Grade (0-100)</label><input type="number" id="gv-' + sid + '" min="0" max="100" placeholder="Score" /></div>' +
            '<div class="form-group" style="margin:0"><label style="font-size:.8rem">Feedback</label><input type="text" id="gf-' + sid + '" placeholder="Feedback for student" /></div>' +
            '</div><button class="btn btn-primary btn-sm" style="margin-top:8px" onclick="submitGrade(\'' + sid + '\')">Submit Grade</button>';
        } else {
          html += '<p style="margin-top:6px;font-size:.85rem">Grade: <strong>' + getVal(s,'grade') + '</strong> | ' + (getVal(s,'instructor_feedback') || '') + '</p>';
        }
        html += '</div>';
      });
      el.innerHTML = html;
    })
    .catch(function(){ el.innerHTML = '<div class="alert alert-error">Failed to load submissions.</div>'; });
}

function submitGrade(sid) {
  var grade = document.getElementById('gv-' + sid).value;
  var fb = document.getElementById('gf-' + sid).value;
  if (!grade) { alert('Enter a grade.'); return; }
  var now = new Date().toISOString().replace('T',' ').split('.')[0];
  fetch(API + '/' + SCOPE + '_student_submission/' + sid, { method: 'PATCH', headers: hdrs(), body: JSON.stringify({
    grade: parseFloat(grade), instructor_feedback: fb, status: 'graded', graded_by: currentUser, graded_at: now
  })})
    .then(function(){ showMsg('Grade submitted!', 'success'); loadSubmissions(); })
    .catch(function(){ showMsg('Failed to submit grade.', 'error'); });
}

