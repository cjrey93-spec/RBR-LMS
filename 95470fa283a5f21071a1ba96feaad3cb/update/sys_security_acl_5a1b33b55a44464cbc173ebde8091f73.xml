        <operation display_value="write">write</operation>
        <script><![CDATA[
        // Check if user can modify the associated course
        var courseGR = new GlideRecord('x_1879300_learning_courses');
        if (courseGR.get(current.course)) {
            if (gs.hasRole('x_1879300_learning.admin')) {
                return true;
            }
            return courseGR.getValue('created_by') == gs.getUserID();
        }
        return false;
    ]]></script>
